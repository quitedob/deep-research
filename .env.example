# Required: generate a long random JWT secret; never use sample credentials.
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Default text and vision model; use the identifier configured by your provider.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_DEFAULT_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT=120
DEEPSEEK_MAX_RETRIES=3

# Optional alternative provider and search credentials.
BIGMODEL_API_KEY=
WEB_SEARCH_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_DEFAULT_MODEL=glm-4-flash
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=gemma3:4b
OLLAMA_EMBEDDING_MODEL=embeddinggemma

# PostgreSQL is required. DATABASE_URL may override DB_* fields.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=deep_research
DB_MIN_POOL_SIZE=5
DB_MAX_POOL_SIZE=20
SEED_DEMO_USERS=false

# Redis is required for token revocation, refresh rotation, quotas, and caches.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
RATE_LIMIT_WINDOW_SECONDS=3600
RATE_LIMIT_MAX_REQUESTS=1000

# API serves a single research-task worker; a database advisory lock enforces it.
API_HOST=127.0.0.1
API_PORT=8000
API_RELOAD=false
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RESEARCH_STREAM_TIMEOUT_SECONDS=3600
RESEARCH_TIMEOUT_SECONDS=1800
RESEARCH_MAX_ACTIVE_SESSIONS=16
RESEARCH_CACHE_LIMIT=128

# Memory: DeepSeek generates facts/HyDE text; Ollama supplies embeddings.
MEMORY_ENABLED=true
MEMORY_GENERATION_MODEL=deepseek-flash
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_NAME=user_memories
HYDE_ENABLED=true
HYDE_TEMPERATURE=0.7
HYDE_MAX_TOKENS=150
MEMORY_TOP_K=5
MEMORY_MIN_VALIDITY=0.7
MEMORY_CACHE_ENABLED=true
MEMORY_CACHE_TTL=3600
MEMORY_QUERY_CACHE_TTL=300
MEMORY_EXTRACTION_TEMP=0.3
MEMORY_EXTRACTION_MAX_TOKENS=500
MEMORY_BATCH_SIZE=10
MEMORY_MAX_FACT_LENGTH=500
MEMORY_MIN_FACT_LENGTH=5
